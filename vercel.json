{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },

    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/about-us/", "destination": "/about", "permanent": true },

    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/contact-us/", "destination": "/contact", "permanent": true },

    { "source": "/residential", "destination": "/services/residential-electrician", "permanent": true },
    { "source": "/residential/", "destination": "/services/residential-electrician", "permanent": true },

    { "source": "/commercial", "destination": "/services/commercial-electrical-fitouts", "permanent": true },
    { "source": "/commercial/", "destination": "/services/commercial-electrical-fitouts", "permanent": true },

    { "source": "/gallery", "destination": "/case-studies", "permanent": true },
    { "source": "/gallery/", "destination": "/case-studies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
